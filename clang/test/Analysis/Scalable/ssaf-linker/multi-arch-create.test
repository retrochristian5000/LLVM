// Tests for `clang-ssaf-linker multi-arch create`.
//
// These tests exercise the CLI shape (subcommand dispatch, verb positional,
// flag surface) and the happy / error paths of MultiArchStaticLibrary and
// MultiArchSharedLibrary construction, mirroring `lipo -create`'s handling
// of thin-or-fat inputs.

// RUN: rm -rf %t
// RUN: mkdir -p %t

// ============================================================================
// Happy path (static family): two bare StaticLibrary inputs, explicit --namespace
// ============================================================================

// RUN: clang-ssaf-linker multi-arch create %S/Inputs/lib-arm64.json %S/Inputs/lib-x86_64.json -o %t/libfat-2arch.json --namespace libfat
// RUN: diff %S/Outputs/libfat-2arch.json %t/libfat-2arch.json

// ============================================================================
// Happy path (static family): --namespace defaults to the output file stem
// ============================================================================

// RUN: clang-ssaf-linker multi-arch create %S/Inputs/lib-arm64.json %S/Inputs/lib-x86_64.json -o %t/libfat.json
// RUN: diff %S/Outputs/libfat-2arch.json %t/libfat.json

// ============================================================================
// Happy path (static family): flatten an existing fat bundle + a bare input
// of a new triple, re-bundling into a 3-member MultiArchStaticLibrary
// ============================================================================

// RUN: clang-ssaf-linker multi-arch create %t/libfat-2arch.json %S/Inputs/lib-ios.json -o %t/libfat-3arch.json --namespace libfat
// RUN: diff %S/Outputs/libfat-3arch.json %t/libfat-3arch.json

// ============================================================================
// Happy path (shared family): two bare LUSummaryEncoding inputs
// ============================================================================

// A shared-family bundle's identity is inferred from its members' own
// namespace, so no --namespace flag is passed here.
// RUN: clang-ssaf-linker multi-arch create %S/Inputs/lu-arm64.json %S/Inputs/lu-x86_64.json -o %t/libshared-2arch.json
// RUN: diff %S/Outputs/libshared-2arch.json %t/libshared-2arch.json

// ============================================================================
// Happy path (shared family): flatten an existing fat bundle + a bare input
// of a new triple, re-bundling into a 3-member MultiArchSharedLibrary
// ============================================================================

// RUN: clang-ssaf-linker multi-arch create %S/Inputs/libshared-2arch.json %S/Inputs/lu-ios-libfoo.json -o %t/libshared-3arch.json
// RUN: diff %S/Outputs/libshared-3arch.json %t/libshared-3arch.json

// ============================================================================
// Mixed-family rejection
// ============================================================================

// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/lib-arm64.json %S/Inputs/lu-arm64.json -o %t/mix1.json --namespace libfat 2>&1 \
// RUN:   | FileCheck %s --check-prefix=MIXED-STATIC-THEN-SHARED
// MIXED-STATIC-THEN-SHARED: input '{{.*}}lu-arm64.json' is a shared-library artifact, but a preceding input established this bundle as static-library

// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/lu-arm64.json %S/Inputs/lib-arm64.json -o %t/mix2.json 2>&1 \
// RUN:   | FileCheck %s --check-prefix=MIXED-SHARED-THEN-STATIC
// MIXED-SHARED-THEN-STATIC: input '{{.*}}lib-arm64.json' is a static-library artifact, but a preceding input established this bundle as shared-library

// ============================================================================
// Raw TUSummaryEncoding rejection
// ============================================================================

// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/tu-empty.json -o %t/tu-reject.json 2>&1 \
// RUN:   | FileCheck %s --check-prefix=INVALID-KIND
// INVALID-KIND: '{{.*}}tu-empty.json' is a raw TU summary, not a valid input to multi-arch create: run static-library create or an entity-linking step first

// ============================================================================
// Duplicate architecture slice
// ============================================================================

// Across two bare inputs (the same file passed twice).
// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/lib-arm64.json %S/Inputs/lib-arm64.json -o %t/dup-bare.json --namespace libfat 2>&1 \
// RUN:   | FileCheck %s --check-prefix=DUP-BARE
// DUP-BARE: duplicate architecture slice 'arm64-apple-macosx' contributed by both '{{.*}}lib-arm64.json' and '{{.*}}lib-arm64.json'

// Straddling a flattened fat input and a separate bare input.
// RUN: not clang-ssaf-linker multi-arch create %t/libfat-2arch.json %S/Inputs/lib-arm64.json -o %t/dup-flattened.json --namespace libfat 2>&1 \
// RUN:   | FileCheck %s --check-prefix=DUP-FLATTENED
// DUP-FLATTENED: duplicate architecture slice 'arm64-apple-macosx' contributed by both '{{.*}}libfat-2arch.json' and '{{.*}}lib-arm64.json'

// ============================================================================
// Namespace mismatch
// ============================================================================

// A bare StaticLibrary member's own namespace disagrees with the target.
// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/lib-otherns.json -o %t/nsmismatch-bare.json --namespace libfat 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NS-MISMATCH-BARE
// NS-MISMATCH-BARE: namespace BuildNamespace(StaticLibrary, otherlib) from '{{.*}}lib-otherns.json' does not match expected namespace BuildNamespace(StaticLibrary, libfat)

// A MultiArchStaticLibrary wrapper's own namespace disagrees with the target.
// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/libfat-multiarch-wrongns.json -o %t/nsmismatch-wrapper.json --namespace libfat 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NS-MISMATCH-WRAPPER
// NS-MISMATCH-WRAPPER: namespace BuildNamespace(MultiArchStaticLibrary, otherlib) from '{{.*}}libfat-multiarch-wrongns.json' does not match expected namespace BuildNamespace(MultiArchStaticLibrary, libfat)

// A bare LUSummaryEncoding member's own namespace disagrees with the target
// (inferred from the first input).
// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/lu-arm64.json %S/Inputs/lu-otherns.json -o %t/nsmismatch-shared.json 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NS-MISMATCH-SHARED
// NS-MISMATCH-SHARED: namespace NestedBuildNamespace([BuildNamespace(LinkUnit, othershared)]) from '{{.*}}lu-otherns.json' does not match expected namespace NestedBuildNamespace([BuildNamespace(LinkUnit, libshared)])

// ============================================================================
// --namespace is not supported for the shared family
// ============================================================================

// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/lu-arm64.json -o %t/nsflag-shared.json --namespace foo 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NAMESPACE-FLAG-SHARED
// NAMESPACE-FLAG-SHARED: --namespace is not supported when bundling shared-library members: identity is inferred from the first member's own namespace

// ============================================================================
// Zero candidates after flattening (every input is an empty fat bundle)
// ============================================================================

// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/libfat-empty-wrapper.json -o %t/zerocand.json --namespace libfat 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NO-CANDIDATES
// NO-CANDIDATES: no candidate members could be derived from the given inputs: at least one member is required

// ============================================================================
// Empty input list
// ============================================================================

// RUN: not clang-ssaf-linker multi-arch create -o %t/no-inputs.json 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NO-INPUTS
// NO-INPUTS: no input artifacts: at least one input is required

// ============================================================================
// Output already exists
// ============================================================================

// RUN: not clang-ssaf-linker multi-arch create %S/Inputs/lib-arm64.json -o %t/libfat-2arch.json --namespace libfat 2>&1 \
// RUN:   | FileCheck %s --check-prefix=OUTPUT-EXISTS
// OUTPUT-EXISTS: clang-ssaf-linker: error: failed to validate path '{{.*}}libfat-2arch.json': File already exists

// ============================================================================
// Unknown verb
// ============================================================================

// RUN: not clang-ssaf-linker multi-arch extract %S/Inputs/lib-arm64.json -o %t/unknown.json 2>&1 \
// RUN:   | FileCheck %s --check-prefix=UNKNOWN-VERB
// UNKNOWN-VERB: unknown multi-arch verb 'extract': expected 'create'

// ============================================================================
// Round-trip: produced bundles parse cleanly with clang-ssaf-format
// ============================================================================

// RUN: clang-ssaf-format --type multi-arch-static-library %t/libfat-3arch.json -o %t/libfat-3arch-roundtrip.json
// RUN: diff %t/libfat-3arch.json %t/libfat-3arch-roundtrip.json

// RUN: clang-ssaf-format --type multi-arch-shared-library %t/libshared-3arch.json -o %t/libshared-3arch-roundtrip.json
// RUN: diff %t/libshared-3arch.json %t/libshared-3arch-roundtrip.json
