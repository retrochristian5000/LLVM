RUN: rm -rf %t1 %t2; mkdir -p %t1 %t2

RUN: %no-lsystem-lld -v -dylib -o /dev/null -L%t1 -F%t2 2>&1 \
RUN:     | FileCheck -DLDIR=%t1 -DFDIR=%t2 %s
CHECK:      Library search paths:
CHECK-NEXT: [[LDIR]]
CHECK-NEXT: /usr/lib
CHECK-NEXT: Framework search paths:
CHECK-NEXT: [[FDIR]]
CHECK-NEXT: /System/Library/Frameworks

RUN: %no-lsystem-lld -v -dylib -o /dev/null -L%t1 -F%t2 -Z 2>&1 \
RUN:     | FileCheck -DLDIR=%t1 -DFDIR=%t2 --check-prefix=CHECK_Z %s
CHECK_Z:      Library search paths:
CHECK_Z-NEXT: [[LDIR]]
CHECK_Z-NEXT: Framework search paths:
CHECK_Z-NEXT: [[FDIR]]

# Invalid search directories are omitted from the link; distinguish missing
# paths from existing files and name the offending -L/-F option.
RUN: touch %t1/not-a-directory
RUN: %no-lsystem-lld -dylib -o /dev/null -L%t1/missing -F%t1/not-a-directory 2>&1 \
RUN:     | FileCheck -DMISSING=%t1/missing -DFILE=%t1/not-a-directory --check-prefix=PATH-DIAG %s
PATH-DIAG: warning: ignoring -L search directory '[[MISSING]]': path does not exist; supply an existing directory
PATH-DIAG: warning: ignoring -F search directory '[[FILE]]': path is not a directory
