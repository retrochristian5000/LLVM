; CHECK-NEXT:    [[Z32:%.*]] = zext i16 [[K]] to i32
; CHECK-NEXT:    [[Z64:%.*]] = zext i16 [[K]] to i64
; CHECK-NEXT:    [[PA:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV]]
; CHECK-NEXT:    store i32 [[Z32]], ptr [[PA]], align 4
; CHECK-NEXT:    [[PB:%.*]] = getelementptr inbounds i64, ptr [[B]], i64 [[IV]]
; CHECK-NEXT:    store i64 [[Z64]], ptr [[PB]], align 8
